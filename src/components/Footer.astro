---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
    <p>爱在日常，心向彼此，和你一起，岁岁年年</p>
    <p>
        © {currentYear === 2026 ? "2026" : `2026–${currentYear}`}&nbsp;·&nbsp;
        <a
            href="https://github.com/ourluvs/our-story"
            target="_blank"
            rel="noopener noreferrer"
        >
            我们的故事
        </a>
    </p>
</footer>

<style>
    .site-footer {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--color-muted);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
    }

    .site-footer p {
        margin: 0;
    }
</style>
